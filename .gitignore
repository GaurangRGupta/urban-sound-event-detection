# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Downloaded audio, labels, features, and checkpoints stay out of git.
# DVC writes a small pointer next to each tracked folder. Those pointers are committed.
# Only the two DVC-tracked folders are listed. A wildcard such as data/* makes
# DVC skip the whole data folder, so it never finds data/raw.dvc.
/data/raw
/data/cache

# EDA pictures written by the notebook. The notebook stores the same pictures in its outputs.
reports/eda/

# Jupyter autosave copies
.ipynb_checkpoints/

submission_documents/
internal_documents/

# Downloaded paper PDFs. papers/README.md stays visible to git so the sources can be fetched again.
papers/*
!papers/README.md
